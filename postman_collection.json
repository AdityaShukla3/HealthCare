				{
					"name": "Login User (Captures Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set('jwt_access_token', jsonData.access);",
									"    console.log('JWT Access Token saved successfully!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"doctor.staff@healthcare.com\",\n    \"password\": \"Staff@123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login/",
